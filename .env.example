# PostgreSQL connection string (Supabase / Neon / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subviet_portal?schema=public"

# Admin login password (plain text for local dev, or use ADMIN_PASSWORD_HASH with bcrypt hash)
ADMIN_PASSWORD="change-this-admin-password"
# ADMIN_PASSWORD_HASH="$2b$10$..."

# Random 32+ char secret for signing Admin session cookie
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# TMDB API v3 Key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY="your-tmdb-api-key"

# Public site URL for SEO / sitemap / share text
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="SubViet Portal"
